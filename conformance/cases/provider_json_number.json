                  "op": "reply_with_decimal_amounts",
                  "provider_payload_json": "{\"balances\": {\"token_balance_wei\": 115792089237316195423570985008687907853269984665640564039457584007913129639935, \"token_balance_wei_float\": 115792089237316195423570985008687907853269984665640564039457584007913129639935.0, \"precise_fraction\": 123456789012345678.987654321}}",
                  "amounts": [
                    {
                      "payload_path": [
                        "balances",
                        "token_balance_wei"
                      ],
                      "asset": "eth-wei",
                      "insert_into": [
                        "observations",
                        0,
