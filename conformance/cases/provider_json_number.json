          ],
          "history.read": [
            {
              "when": {
                "resources": [
                  {
                    "resource_id": "wallet-decimal"
                  }
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [],
                    "statuses": [
                      {
                        "resource_id": "wallet-decimal",
                        "page": {
                          "cursor_resumable": "exact",
                          "next": null
