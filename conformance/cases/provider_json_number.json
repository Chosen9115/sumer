                      }
                    ]
                  }
                }
              ]
            }
          ],
          "status.read": [
            {
              "when": {
                "resource_ids": [
                  "wallet-decimal"
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "statuses": [
                      {
                        "resource_id": "wallet-decimal",
                        "outcome": {
                          "fetched": {
                            "page_empty": false
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "balances.read": [
            {
              "when": {
                "resource_ids": [
                  "wallet-decimal"
                ]
              },
              "do": [
                {
                  "op": "reply_with_decimal_amounts",
                  "provider_payload_json": "{\"balances\": {\"token_balance_wei\": 115792089237316195423570985008687907853269984665640564039457584007913129639935, \"token_balance_wei_float\": 115792089237316195423570985008687907853269984665640564039457584007913129639935.0, \"precise_fraction\": 123456789012345678.987654321, \"high_precision_debit_unsigned\": 12345678901234567890123456789.01}}",
                  "amounts": [
