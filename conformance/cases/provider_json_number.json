              ]
            },
            {
              "when": {
                "resource_ids": [
                  "wallet-decimal"
                ]
              },
              "do": [
                {
                  "op": "reply_ok_raw",
                  "body_json": "{\"observations\":[{\"resource_id\":\"wallet-decimal\",\"category\":\"available\",\"canonical_hint\":null,\"amount\":{\"asset\":\"USD\",\"amount\":10.25},\"provenance\":{\"adapter_id\":\"fake-adapter\",\"provider_id\":\"0xEXAMPLEDECIMALWALLET\",\"surface\":\"onchain\",\"observed_at\":\"2026-09-01T00:00:00Z\",\"completeness\":\"complete\"}}],\"statuses\":[{\"resource_id\":\"wallet-decimal\",\"outcome\":{\"fetched\":{\"page_empty\":false}}}]}"
