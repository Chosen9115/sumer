                        "amount"
                      ]
                    }
                  ],
                  "body": {
                    "observations": [
                      {
                        "resource_id": "wallet-decimal",
                        "category": "token_balance_wei_bare_int",
                        "canonical_hint": null,
                        "amount": null,
                        "provenance": {
                          "adapter_id": "fake-adapter",
                          "provider_id": "0xEXAMPLEDECIMALWALLET",
