          ],
          "history.read": [
            {
              "when": {
                "resources": [
                  {
                    "resource_id": "wallet-decimal",
                    "page": {
                      "kind": "cursor",
                      "cursor": ""
                    }
                  }
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [],
                    "statuses": [
                      {
                        "resource_id": "wallet-decimal",
                        "outcome": {
                          "fetched": {
                            "page_empty": true
                          }
                        },
                        "page": {
                          "cursor_resumable": "exact",
                          "next": null
