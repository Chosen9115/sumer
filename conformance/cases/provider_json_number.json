{
  "case": "provider_json_number",
  "script": {
    "runs": [
      {
        "label": "default",
        "hello": {
          "protocol": "1",
          "adapter_id": "fake-adapter",
          "adapter_version": "0.1.0",
          "capabilities": [
            "resources.list",
            "balances.read",
            "history.read",
            "status.read"
          ],
          "local_id_derivation": "fixture-literal@1",
          "max_in_flight": 1
        },
        "on": {
          "resources.list": [
            {
              "do": [
                {
                  "op": "reply_ok",
