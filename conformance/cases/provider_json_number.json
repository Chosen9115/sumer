                      },
                      {
                        "resource_id": "wallet-decimal",
                        "category": "token_balance_wei_float_token",
                        "canonical_hint": null,
                        "amount": null,
                        "provenance": {}
                      },
                      {
                        "resource_id": "wallet-decimal",
                        "category": "precise_fraction",
                        "canonical_hint": null,
                        "amount": null,
                        "provenance": {}
                      },
                      {
                        "resource_id": "wallet-decimal",
                        "category": "high_precision_debit",
                        "canonical_hint": null,
                        "amount": null,
                        "provenance": {}
                      }
                    ],
                    "statuses": [
