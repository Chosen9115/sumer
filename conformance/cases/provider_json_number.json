                          "completeness": "complete"
                        }
                      },
                      {
                        "resource_id": "wallet-decimal",
                        "category": "precise_fraction",
                        "canonical_hint": null,
                        "amount": null,
                        "provenance": {
                          "adapter_id": "fake-adapter",
                          "provider_id": "0xEXAMPLEDECIMALWALLET",
                          "surface": "onchain",
                          "observed_at": "2026-09-01T00:00:00Z",
                          "completeness": "complete"
