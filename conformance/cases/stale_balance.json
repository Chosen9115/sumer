{
  "case": "stale_balance",
  "script": {
    "runs": [
      {
        "label": "default",
        "hello": {
          "protocol": "1",
          "adapter_id": "fake-adapter",
          "adapter_version": "0.1.0",
          "capabilities": [
            "resources.list",
            "balances.read",
            "history.read",
            "status.read"
          ],
          "local_id_derivation": "fixture-literal@1",
          "max_in_flight": 1
        },
        "on": {
          "resources.list": [
            {
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "resources": [
                      {
                        "resource_id": "checking-2",
                        "provider_id": "acct_checking_2",
                        "kind": "bank_checking",
                        "label": "Example checking account (fixture placeholder)"
                      },
                      {
                        "resource_id": "checking-3",
                        "provider_id": "acct_checking_3",
                        "kind": "bank_checking",
                        "label": "Second example checking account, used only for the invalid-received_at trap"
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "balances.read": [
            {
              "when": {
                "resource_ids": [
                  "checking-2"
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [
                      {
                        "resource_id": "checking-2",
                        "category": "available",
                        "canonical_hint": "available",
                        "amount": {
                          "asset": "USD",
                          "amount": "300.00"
                        },
                        "provenance": {
                          "adapter_id": "fake-adapter",
                          "provider_id": "acct_checking_2",
                          "surface": "checking",
                          "observed_at": "2026-08-20T00:00:00Z",
                          "completeness": "complete"
                        }
                      }
                    ],
                    "statuses": [
                      {
                        "resource_id": "checking-2",
                        "outcome": {
                          "stale": {
                            "as_of": "2026-08-20T00:00:00Z"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "when": {
                "resource_ids": [
                  "checking-3"
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [
                      {
                        "resource_id": "checking-3",
                        "category": "available",
                        "canonical_hint": "available",
                        "amount": {
                          "asset": "USD",
                          "amount": "88.00"
                        },
                        "provenance": {
                          "adapter_id": "fake-adapter",
                          "provider_id": "acct_checking_3",
                          "surface": "checking",
                          "observed_at": "2026-09-03T00:00:00Z",
                          "received_at": "2026-09-03T00:00:01Z",
                          "completeness": "complete"
                        }
                      }
                    ],
                    "statuses": [
                      {
                        "resource_id": "checking-3",
                        "outcome": {
                          "fetched": {
                            "page_empty": false
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "history.read": [
            {
              "when": {
                "resources": [
                  {
                    "resource_id": "checking-2",
                    "page": {
                      "kind": "cursor",
                      "cursor": ""
                    }
                  }
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [],
                    "statuses": [
                      {
                        "resource_id": "checking-2",
                        "outcome": {
                          "fetched": {
                            "page_empty": true
                          }
                        },
                        "page": {
                          "cursor_resumable": "batch_restart",
                          "next": null
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "when": {
                "resources": [
                  {
                    "resource_id": "checking-3",
                    "page": {
                      "kind": "cursor",
                      "cursor": ""
                    }
                  }
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [],
                    "statuses": [
                      {
                        "resource_id": "checking-3",
                        "outcome": {
                          "fetched": {
                            "page_empty": true
                          }
                        },
                        "page": {
                          "cursor_resumable": "batch_restart",
                          "next": null
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "status.read": [
            {
              "when": {
                "resource_ids": [
                  "checking-2",
                  "checking-3"
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "statuses": [
                      {
                        "resource_id": "checking-2",
                        "outcome": {
                          "stale": {
                            "as_of": "2026-08-20T00:00:00Z"
                          }
                        }
                      },
                      {
                        "resource_id": "checking-3",
                        "outcome": {
                          "fetched": {
                            "page_empty": false
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "assertions": [
      "A3",
      "A4",
      "A7"
    ],
    "resources": [
      {
        "resource_id": "checking-2",
        "kind": "bank_checking"
      },
      {
        "resource_id": "checking-3",
        "kind": "bank_checking"
      }
    ],
    "balances": {
      "checking-2": [
        {
          "category": "available",
          "canonical_hint": "available",
          "amount": {
            "asset": "USD",
            "amount": "300.00"
          }
        }
      ]
    },
    "provenance": {
      "checking-2": {
        "staleness": "cached",
        "completeness": "complete"
      }
    },
    "statuses": {
      "checking-2": {
        "stale": {
          "as_of": "2026-08-20T00:00:00Z"
        }
      }
    },
    "envelope_errors": {
      "checking-3_balances_read": {
        "code": "invalid_request"
      }
    },
    "notes": "checking-2 is the legitimate stale-cache case: the adapter never sends received_at (staleness is host-computed from received_at per spec/wire.md, but this fixture supplies observed_at plus the adapter's OWN staleness/completeness claim as evidence; a host is free to recompute staleness itself, but the adapter's declared 'Cached' + the outcome 'stale{as_of}' must both survive to the caller -- a host that silently drops the stale flag because the amount decoded fine fails A3's spirit and A7). checking-3's balances.read is the ADVERSARIAL half and is LITERAL, not simulated: the scripted reply's provenance object actually carries a 'received_at' field, exactly the field spec/wire.md says the adapter MUST omit. A conforming host's deserializer must reject the WHOLE reply with envelope err.code=invalid_request BEFORE ever looking at the amount inside it -- a host whose Provenance struct just silently ignores an unrecognised/extra field (e.g. no deny_unknown_fields, or a hand-rolled parser that only reads the keys it expects) will instead accept 88.00 as checking-3's live balance and fail this case invisibly. checking-3's own status.read call afterward must still succeed (A4 pairing) -- the invalid_request on the balances.read leg must not kill the connection or block checking-3's status.read."
  }
}
