                        "provider_id": "tx_123",
                        "state": "active",
                        "surface": "primary",
                        "posting": "posted",
                        "amount": {
                          "asset": "sat",
                          "amount": "100000"
                        },
                        "raw_sign": "provider_positive",
                        "description": "EXAMPLE TRANSFER SEEN ON PRIMARY SURFACE (fixture placeholder)",
                        "provider_extra": {},
                        "provenance": {
                          "provider_id": "tx_123",
                          "surface": "primary",
                          "observed_at": "2026-09-01T10:00:00Z"
                        }
                      },
                      {
                        "resource_id": "wallet-multi",
                        "local_id": "wallet-multi:secondary:tx_123",
                        "provider_id": "tx_123",
                        "state": "active",
                        "surface": "secondary",
                        "posting": "posted",
                        "amount": {
                          "asset": "sat",
                          "amount": "200000"
                        },
                        "raw_sign": "provider_positive",
                        "description": "EXAMPLE UNRELATED TRANSFER SEEN ON SECONDARY SURFACE, SAME provider_id BY COINCIDENCE (fixture placeholder)",
                        "provider_extra": {},
                        "provenance": {
                          "provider_id": "tx_123",
                          "surface": "secondary",
                          "observed_at": "2026-09-01T10:00:05Z"
                        }
                      },
                      {
                        "resource_id": "wallet-multi",
                        "local_id": "wallet-multi:primary:tx_123",
                        "provider_id": "tx_123",
                        "state": "active",
                        "surface": "primary",
                        "posting": "posted",
                        "amount": {
                          "asset": "sat",
                          "amount": "100000"
                        },
                        "raw_sign": "provider_positive",
                        "description": "EXAMPLE TRANSFER SEEN ON PRIMARY SURFACE (fixture placeholder)",
                        "provider_extra": {},
