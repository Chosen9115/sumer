    ],
    "ledger": {
      "wallet-multi": {
        "balances": [
          {
            "category": "available",
            "canonical_hint": "available",
            "amount": {
              "asset": "sat",
              "amount": "300000"
            }
          }
        ],
        "history": [
          {
            "local_id": "wallet-multi:primary:tx_123",
            "provider_id": "tx_123",
            "state": "active",
            "surface": "primary",
            "posting": "posted",
            "amount": {
              "asset": "sat",
              "amount": "100000"
            },
            "raw_sign": "provider_positive",
            "provider_extra": {}
          },
          {
            "local_id": "wallet-multi:secondary:tx_123",
            "provider_id": "tx_123",
            "state": "active",
            "surface": "secondary",
            "posting": "posted",
            "amount": {
              "asset": "sat",
              "amount": "200000"
            },
            "raw_sign": "provider_positive",
            "provider_extra": {}
          },
          {
            "local_id": "wallet-multi:primary:tx_123",
            "provider_id": "tx_123",
            "state": "active",
            "surface": "primary",
            "posting": "posted",
            "amount": {
              "asset": "sat",
              "amount": "100000"
            },
            "raw_sign": "provider_positive",
            "provider_extra": {}
          }
        ]
