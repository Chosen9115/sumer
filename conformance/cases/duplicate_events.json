{
  "case": "duplicate_events",
  "script": {
    "runs": [
      {
        "label": "default",
        "on": {
          "resources.list": [
            {
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "resources": [
                      {
                        "resource_id": "wallet-multi",
                        "provider_id": "0xEXAMPLEMULTISURFACEWALLET",
                        "kind": "onchain_wallet",
                        "label": "Example wallet observed via two independent surfaces (fixture placeholder)"
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "balances.read": [
            {
              "when": {
                "resource_ids": [
                  "wallet-multi"
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [
                      {
                        "resource_id": "wallet-multi",
                        "category": "available",
                        "canonical_hint": "available",
                        "amount": {
                          "asset": "sat",
                          "amount": "300000"
                        },
                        "provenance": {
                          "provider_id": "0xEXAMPLEMULTISURFACEWALLET",
