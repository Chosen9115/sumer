                          "fetched": {
                            "page_empty": false
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "history.read": [
            {
              "when": {
                "resources": [
                  {
                    "resource_id": "wallet-oversized"
                  }
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [
                      {
                        "resource_id": "wallet-oversized",
                        "local_id": "wallet-oversized:sibling-small",
                        "provider_id": "sibling-small",
                        "state": "active",
                        "surface": "onchain",
                        "posting": "posted",
                        "amount": {
                          "asset": "sat",
                          "amount": "500"
                        },
                        "raw_sign": "provider_positive",
                        "description": "SMALL SIBLING EVENT, UNTRUNCATED (fixture placeholder)",
                        "provider_extra": {
                          "memo": "small and ordinary"
                        },
                        "provenance": {
                          "provider_id": "sibling-small",
                          "observed_at": "2026-09-01T10:00:00Z"
