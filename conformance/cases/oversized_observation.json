                        "outcome": {
                          "stale": {
                            "as_of": "2026-09-01T09:00:00Z"
                          }
                        },
                        "page": {
                          "cursor_resumable": "exact",
                          "next": null
                        }
                      }
                    ]
                  },
                  "pad": [
                    {
                      "path": [
                        "observations",
                        1,
                        "provider_extra",
                        "bulk_provider_payload"
                      ],
                      "bytes": 120000
                    },
                    {
                      "path": [
