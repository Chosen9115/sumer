                      },
                      {
                        "resource_id": "wallet-oversized",
                        "local_id": "wallet-oversized:big-truncatable",
                        "provider_id": "big-truncatable",
                        "state": "active",
                        "surface": "onchain",
                        "posting": "posted",
                        "amount": {
                          "asset": "sat",
                          "amount": "700000"
