{
  "case": "pending_to_posted",
  "script": {
    "runs": [
      {
        "label": "default",
        "on": {
          "resources.list": [
            {
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "resources": [
                      {
                        "resource_id": "checking-1",
                        "provider_id": "acct_checking_1",
                        "kind": "bank_checking",
                        "label": "Example checking account (fixture placeholder)"
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "balances.read": [
            {
              "when": {
                "resource_ids": [
                  "checking-1"
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [
                      {
                        "resource_id": "checking-1",
                        "category": "available",
                        "canonical_hint": "available",
                        "amount": {
                          "asset": "USD",
                          "amount": "957.63"
                        },
                        "provenance": {
                          "provider_id": "acct_checking_1",
                          "observed_at": "2026-09-01T00:00:00Z"
                        }
                      }
                    ],
                    "statuses": [
                      {
                        "resource_id": "checking-1"
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "history.read": [
            {
              "when": {
                "resources": [
                  {
                    "resource_id": "checking-1"
                  }
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [
                      {
                        "resource_id": "checking-1",
                        "local_id": "checking-1:pend_abc",
                        "provider_id": "pend_abc",
                        "state": "active",
                        "surface": "checking",
                        "posting": "pending",
                        "amount": {
                          "asset": "USD",
                          "amount": "42.00"
                        },
                        "raw_sign": "provider_negative",
                        "description": "EXAMPLE MERCHANT PURCHASE (fixture placeholder)",
                        "provider_extra": {},
                        "provenance": {
                          "provider_id": "pend_abc",
                          "observed_at": "2026-09-01T09:00:00Z"
                        }
                      }
                    ],
                    "statuses": [
                      {
                        "resource_id": "checking-1",
                        "page": {
                          "cursor_resumable": "batch_restart",
                          "next": {
                            "kind": "cursor",
                            "cursor": "checking-1:page2"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "when": {
                "resources": [
                  {
                    "resource_id": "checking-1",
                    "page": {
                      "kind": "cursor",
                      "cursor": "checking-1:page2"
                    }
                  }
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "observations": [
                      {
                        "resource_id": "checking-1",
                        "local_id": "checking-1:pend_abc",
                        "provider_id": "post_xyz",
                        "supersedes_provider_id": "pend_abc",
                        "state": "active",
                        "surface": "checking",
                        "posting": "posted",
                        "amount": {
                          "asset": "USD",
                          "amount": "42.37"
                        },
                        "raw_sign": "provider_negative",
                        "description": "EXAMPLE MERCHANT PURCHASE (fixture placeholder)",
                        "provider_extra": {},
                        "provenance": {
                          "provider_id": "post_xyz",
                          "observed_at": "2026-09-02T09:00:00Z"
                        }
                      }
                    ],
                    "statuses": [
                      {
                        "resource_id": "checking-1",
                        "page": {
                          "cursor_resumable": "batch_restart",
                          "next": null
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "status.read": [
            {
              "when": {
                "resource_ids": [
                  "checking-1"
                ]
              },
              "do": [
                {
                  "op": "reply_ok",
                  "body": {
                    "statuses": [
                      {
                        "resource_id": "checking-1",
                        "outcome": {
                          "fetched": {
                            "page_empty": false
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "provenance": {
          "adapter_id": "fake-adapter",
          "surface": "checking",
          "completeness": "complete"
        }
      }
    ]
  },
  "expect": {
    "assertions": [
      "A2",
      "A8"
    ],
    "resources": [
      {
        "resource_id": "checking-1",
        "kind": "bank_checking"
      }
    ],
    "history_live_set": {
      "checking-1": [
        {
          "local_id": "checking-1:pend_abc",
          "state": "active",
          "posting": "posted",
          "amount": {
            "asset": "USD",
            "amount": "42.37"
          },
          "raw_sign": "provider_negative"
        }
      ]
    },
    "chains": {
      "checking-1:pend_abc": [
        {
          "local_id": "checking-1:pend_abc",
          "provider_id": "pend_abc",
          "state": "active",
          "posting": "pending",
          "amount": {
            "asset": "USD",
            "amount": "42.00"
          }
        },
        {
          "local_id": "checking-1:pend_abc",
          "provider_id": "post_xyz",
          "supersedes_provider_id": "pend_abc",
          "state": "active",
          "posting": "posted",
          "amount": {
            "asset": "USD",
            "amount": "42.37"
          }
        }
      ]
    },
    "notes": "pending and posted share ONE stable local_id; only provider_id changes. Deriving local_id from provider_id would break exactly here, because provider_id is what changes at posting -- which is why the contract forbids dedup by provider_id alone. supersedes_provider_id is audit evidence, not folding input: the fold keys on local_id."
  }
}
